<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="Virtual PLC Papercut SDL3"/>
      <Scaled Value="True"/>
      <ResourceType Value="res"/>
      <UseXPManifest Value="True"/>
      <XPManifest>
        <DpiAware Value="True"/>
      </XPManifest>
    </General>
    <BuildModes>
      <Item Name="Release" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="SDL3_package"/>
      </Item>
      <Item>
        <PackageName Value="BGRABitmapPack"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
      <Item>
        <PackageName Value="TurboPowerIPro"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="VirtualPLC_test.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="uplctypes.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uPlcTypes"/>
      </Unit>
      <Unit>
        <Filename Value="uplcproject.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uPlcProject"/>
      </Unit>
      <Unit>
        <Filename Value="uplccompiler.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uPlcCompiler"/>
      </Unit>
      <Unit>
        <Filename Value="uplcruntime.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uPlcRuntime"/>
      </Unit>
      <Unit>
        <Filename Value="upaperdl.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uPaperDL"/>
      </Unit>
      <Unit>
        <Filename Value="urenderpool.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uRenderPool"/>
      </Unit>
      <Unit>
        <Filename Value="uframe.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uFrame"/>
      </Unit>
      <Unit>
        <Filename Value="uuibase.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uUiBase"/>
      </Unit>
      <Unit>
        <Filename Value="uui.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uUi"/>
      </Unit>
      <Unit>
        <Filename Value="usdlview.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uSDLView"/>
      </Unit>
      <Unit>
        <Filename Value="uinfoform.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uInfoForm"/>
      </Unit>
      <Unit>
        <Filename Value="uexport.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uExport"/>
      </Unit>
      <Unit>
        <Filename Value="umfvideo.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uMFVideo"/>
      </Unit>
      <Unit>
        <Filename Value="uplcserver.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uPlcServer"/>
      </Unit>
      <Unit>
        <Filename Value="uplcclient.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uPlcClient"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="VirtualPLC_test"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <CodeGeneration>
      <SmartLinkUnit Value="True"/>
      <Optimizations>
        <OptimizationLevel Value="3"/>
      </Optimizations>
    </CodeGeneration>
    <Linking>
      <Debugging>
        <GenerateDebugInfo Value="False"/>
        <RunWithoutDebug Value="True"/>
      </Debugging>
      <LinkSmart Value="True"/>
      <Options>
        <Win32>
          <GraphicApplication Value="True"/>
        </Win32>
      </Options>
    </Linking>
  </CompilerOptions>
</CONFIG>
