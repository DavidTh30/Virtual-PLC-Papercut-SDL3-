    },
    {
      "address" : "AM1",
      "format" : "DEC",
      "modify" : ""
    }
  ],
  "miniWatch" : [
    {
      "address" : "B002.Cv",
      "format" : "DEC"
    },
    {
      "address" : "AI1",
      "format" : "DEC"
    }
  ],
