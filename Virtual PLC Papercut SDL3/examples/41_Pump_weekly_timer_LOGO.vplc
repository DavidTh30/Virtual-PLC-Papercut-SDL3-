    0,
    0,
    0,
    0
  ],
  "aiChannels" : [
    {
      "mode" : "manual",
      "value" : 0
    },
    {
      "mode" : "manual",
      "value" : 0
    },
    {
      "mode" : "manual",
      "value" : 0
    },
    {
