    }
  ],
  "comm" : {
    "s7" : true,
    "s7Port" : 102,
    "modbus" : true,
    "modbusPort" : 502,
    "modbusUnit" : 1,
    "holding" : "M",
    "putGet" : true,
    "allInterfaces" : false,
    "ip" : "127.0.0.1",
    "mask" : "255.255.255.0",
    "ipc" : false
  }
}
