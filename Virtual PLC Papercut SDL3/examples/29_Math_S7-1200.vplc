        },
        {
          "name" : "Sq",
          "type" : "Real",
          "start" : "0.0",
          "comment" : "SQR(1.5)"
        },
        {
          "name" : "E1",
          "type" : "Real",
          "start" : "0.0",
          "comment" : "EXP(1)"
        },
        {
          "name" : "Ln10",
          "type" : "Real",
          "start" : "0.0",
          "comment" : "LN(10)"
        },
        {
          "name" : "Log1000",
          "type" : "Real",
          "start" : "0.0",
          "comment" : "LOG(1000): 3"
        },
        {
          "name" : "Frac",
          "type" : "Real",
          "start" : "0.0",
          "comment" : "FRAC(X / Y)"
        },
        {
          "name" : "MinAB",
          "type" : "Int",
          "start" : "0",
