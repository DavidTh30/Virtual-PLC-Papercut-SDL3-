        },
        {
          "name" : "Hyp",
          "type" : "Real",
          "start" : "0.0",
          "comment" : "SQRT(X*X + Y*Y): 5"
        },
        {
          "name" : "Ratio",
          "type" : "Real",
          "start" : "0.0",
          "comment" : "X / Y"
        },
        {
          "name" : "Pow",
          "type" : "Real",
          "start" : "0.0",
          "comment" : "X ** 3"
        },
        {
          "name" : "R",
          "type" : "Real",
          "start" : "2.0",
          "comment" : "radius"
        },
        {
          "name" : "Area",
          "type" : "Real",
          "start" : "0.0",
          "comment" : "pi * R * R"
        },
        {
          "name" : "Angle",
          "type" : "Real",
