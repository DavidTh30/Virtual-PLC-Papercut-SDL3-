{
  "format" : "VirtualPLC",
  "version" : 1,
  "name" : "Math: arithmetic, functions, trigonometry (S7-1200)",
  "author" : "Virtual PLC examples",
  "comment" : "SCL and LAD: Int division and MOD, Real arithmetic, SQRT / SQR / EXP / LN / LOG, SIN / COS / TAN in degrees, MIN / MAX / LIMIT / ABS, the average of an array with FOR, a polynomial, and the LAD boxes ADD / SUB / MUL / DIV. Modify A, B, X, Y, R, Angle in the watch table.",
  "cpu" : "CPU 1214C DC/DC/DC",
  "family" : "S7-1200",
  "cyclicMs" : 100,
  "clockByte" : 0,
  "blocks" : [
    {
      "kind" : "OB",
      "number" : 1,
      "name" : "Main",
      "comment" : "Main program cycle",
      "networks" : [
        {
          "title" : "Integer arithmetic",
          "comment" : "Int / Int is an Int division, MOD the rest",
          "lang" : "SCL",
          "scl" : [
            "\"Math\".Sum := \"Math\".A + \"Math\".B;",
            "\"Math\".Diff := \"Math\".A - \"Math\".B;",
            "\"Math\".Prod := \"Math\".A * \"Math\".B;",
            "\"Math\".Quot := \"Math\".A / \"Math\".B;",
            "\"Math\".Rest := \"Math\".A MOD \"Math\".B;"
          ]
        },
        {
          "title" : "Real arithmetic and geometry",
          "comment" : "Pythagoras, a circle, a power",
          "lang" : "SCL",
          "scl" : [
            "\"Math\".Hyp := SQRT(\"Math\".X * \"Math\".X + \"Math\".Y * \"Math\".Y);",
            "\"Math\".Ratio := \"Math\".X / \"Math\".Y;",
            "\"Math\".Pow := \"Math\".X ** 3.0;",
            "\"Math\".Area := 3.14159265 * \"Math\".R * \"Math\".R;"
          ]
        },
        {
          "title" : "Trigonometry in degrees",
          "comment" : "SIN / COS / TAN take radians",
          "lang" : "SCL",
          "scl" : [
            "VAR_TEMP",
            "    rad : Real;",
            "END_VAR",
            "#rad := \"Math\".Angle * 3.14159265 / 180.0;",
            "\"Math\".SinA := SIN(#rad);",
            "\"Math\".CosA := COS(#rad);",
            "\"Math\".TanA := TAN(#rad);"
          ]
        },
        {
          "title" : "Roots, powers, logarithms",
          "comment" : "",
          "lang" : "SCL",
          "scl" : [
            "\"Math\".Root2 := SQRT(2.0);",
            "\"Math\".Sq := SQR(1.5);",
            "\"Math\".E1 := EXP(1.0);",
            "\"Math\".Ln10 := LN(10.0);",
            "\"Math\".Log1000 := LOG(1000.0);",
            "\"Math\".Frac := FRAC(\"Math\".X / \"Math\".Y);"
          ]
        },
        {
          "title" : "MIN, MAX, LIMIT, ABS",
          "comment" : "",
          "lang" : "SCL",
          "scl" : [
            "\"Math\".MinAB := MIN(IN1 := \"Math\".A, IN2 := \"Math\".B);",
            "\"Math\".MaxAB := MAX(IN1 := \"Math\".A, IN2 := \"Math\".B);",
            "\"Math\".Lim := LIMIT(MN := 0, IN := \"Math\".A * \"Math\".B, MX := 20);",
            "\"Math\".AbsV := ABS(\"Math\".X - \"Math\".Y);"
          ]
        },
        {
          "title" : "The average of an array, a polynomial",
          "comment" : "FOR over Vals[1..5]; Horner: (2 X - 3) X + 1",
          "lang" : "SCL",
          "scl" : [
            "VAR_TEMP",
            "    i : Int;",
            "    sum : Real;",
            "END_VAR",
            "FOR #i := 1 TO 5 DO",
            "    \"Math\".Vals[#i] := INT_TO_REAL(#i) * 1.5;",
            "END_FOR;",
            "#sum := 0.0;",
            "FOR #i := 1 TO 5 DO",
            "    #sum := #sum + \"Math\".Vals[#i];",
            "END_FOR;",
            "\"Math\".Avg := #sum / 5.0;",
            "\"Math\".Poly := (2.0 * \"Math\".X - 3.0) * \"Math\".X + 1.0;"
          ]
        },
        {
          "title" : "LAD: ADD Int",
          "comment" : "",
          "lang" : "LAD",
          "rows" : 1,
          "cells" : [
            {
              "r" : 0,
              "c" : 0,
              "e" : "add",
              "p" : [
                "\"Math\".A",
                "\"Math\".B",
                "\"Math\".Lad_Sum"
              ],
              "type" : "Int"
            }
          ]
        },
        {
          "title" : "LAD: SUB DInt",
          "comment" : "",
          "lang" : "LAD",
          "rows" : 1,
          "cells" : [
            {
              "r" : 0,
              "c" : 0,
              "e" : "sub",
              "p" : [
                "\"Math\".Big",
                "70000",
                "\"Math\".Lad_Diff"
              ],
              "type" : "DInt"
            }
          ]
        },
        {
          "title" : "LAD: MUL Real",
          "comment" : "",
          "lang" : "LAD",
          "rows" : 1,
          "cells" : [
            {
              "r" : 0,
              "c" : 0,
              "e" : "mul",
              "p" : [
                "\"Math\".X",
                "\"Math\".Y",
                "\"Math\".Lad_Prod"
              ],
              "type" : "Real"
            }
          ]
        },
        {
          "title" : "LAD: DIV Real",
          "comment" : "",
          "lang" : "LAD",
          "rows" : 1,
          "cells" : [
            {
              "r" : 0,
              "c" : 0,
              "e" : "div",
              "p" : [
                "\"Math\".X",
                "\"Math\".Y",
                "\"Math\".Lad_Quot"
              ],
              "type" : "Real"
            }
          ]
        }
      ]
    }
  ],
  "dbs" : [
    {
      "number" : 1,
      "name" : "Math",
      "comment" : "",
      "optimized" : false,
      "vars" : [
        {
