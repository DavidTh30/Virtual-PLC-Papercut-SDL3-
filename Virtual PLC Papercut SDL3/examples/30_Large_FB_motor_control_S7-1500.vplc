  "tags" : [
    {
      "name" : "Clock_2Hz",
      "type" : "Bool",
      "address" : "%M0.3",
      "comment" : "clock memory 2 Hz"
    },
    {
      "name" : "Clock_1Hz",
      "type" : "Bool",
      "address" : "%M0.5",
      "comment" : "clock memory 1 Hz"
    },
    {
      "name" : "M1_Start",
      "type" : "Bool",
      "address" : "%I0.0",
      "comment" : "motor 1 start (hand)"
    },
    {
      "name" : "M1_Stop",
      "type" : "Bool",
      "address" : "%I0.1",
      "comment" : "motor 1 stop (hand)"
