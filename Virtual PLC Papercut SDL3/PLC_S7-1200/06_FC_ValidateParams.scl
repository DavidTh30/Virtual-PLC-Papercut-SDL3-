// =============================================================================
// Fluff Silo System - S7-1200
// FC "FC_ValidateParams" : clamp parameters written by the HMI into DB_HMI
//   delays        0 .. 6000  (0 .. 600.0 s)
//   step count    0 .. 10
//   step mask     0 .. 7     (bit0 = Paddle01, bit1 = Paddle02, bit2 = Paddle03)
//   step time     5 .. 6000  (0.5 .. 600.0 s)
// =============================================================================
FUNCTION "FC_ValidateParams" : Void
TITLE = 'Clamp HMI parameters'
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_TEMP
      i : Int;
   END_VAR


BEGIN
	FOR #i := 0 TO 5 DO
	    "DB_HMI".Delay[#i] := LIMIT(MN := 0, IN := "DB_HMI".Delay[#i], MX := 6000);
	END_FOR;

	"DB_HMI".Pattern.StepCount := LIMIT(MN := 0, IN := "DB_HMI".Pattern.StepCount, MX := 10);

	FOR #i := 0 TO 9 DO
	    "DB_HMI".Pattern.Mask[#i] := LIMIT(MN := 0, IN := "DB_HMI".Pattern.Mask[#i], MX := 7);
	    "DB_HMI".Pattern.StepTime[#i] := LIMIT(MN := 5, IN := "DB_HMI".Pattern.StepTime[#i], MX := 6000);
	END_FOR;

END_FUNCTION
